# Copy to .env and change what you need. All settings are described in backend/config.py.

# Code a lecturer or tutor must give when registering. Leave empty to only allow
# `python accounts.py create-staff` on the server.
LOSTPOINT_STAFF_CODE=change-me

# Browser origins allowed to call the API from another host (comma-separated).
# Not needed for the single container or the Vite dev server.
LOSTPOINT_CORS_ORIGINS=

# fts (default, no downloads) or chroma (semantic search, needs: pip install chromadb)
LOSTPOINT_SEARCH=fts

LOSTPOINT_SESSION_DAYS=14
LOSTPOINT_LOG_LEVEL=INFO
