# Canvas LMS integration
# ./scripts/setup-canvas.sh writes the live values into backend/.env.
CANVAS_BASE_URL=http://localhost
CANVAS_API_TOKEN=

# Canvas OAuth2. backend/scripts/setup_canvas_oauth.py fills these in.
CANVAS_CLIENT_ID=
CANVAS_CLIENT_SECRET=
CANVAS_REDIRECT_URI=http://localhost:5173/api/auth/canvas/callback
FRONTEND_ORIGIN=http://localhost:5173
CANVAS_DEMO_COURSE_ID=1

# Session signing key. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=change-me

# Optional overrides
# LOSTPOINT_DB=lostpoint.db
# SESSION_MAX_AGE=604800
# COOKIE_SECURE=false
# CANVAS_TIMEOUT=30
