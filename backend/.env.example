# Copy to backend/.env (gitignored). Everything is optional for a local demo.

# --- AI: coach (Stephanie) and caption translation (Nevia) ---
# Without a key the coach uses the offline demo provider and captions are mock-translated.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
TRANSLATION_MODEL=claude-haiku-5-5
# Optional: enable ElevenLabs Scribe v2 Realtime for microphone captions.
ELEVENLABS_API_KEY=
# Optional: require this key for the lecture-source (speaker) caption connection.
SPEAKER_KEY=

# --- Canvas LMS login (Jamie). ./scripts/setup-canvas.sh writes the live values. ---
CANVAS_BASE_URL=http://localhost
CANVAS_API_TOKEN=

# Canvas OAuth2. backend/scripts/setup_canvas_oauth.py fills these in.
CANVAS_CLIENT_ID=
CANVAS_CLIENT_SECRET=
CANVAS_REDIRECT_URI=http://localhost:5173/api/auth/canvas/callback
FRONTEND_ORIGIN=http://localhost:5173
CANVAS_DEMO_COURSE_ID=1

# Session signing key. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=change-me

# Optional overrides
# LOSTPOINT_DB=lostpoint.db
# SESSION_MAX_AGE=604800
# COOKIE_SECURE=false
# CANVAS_TIMEOUT=30
